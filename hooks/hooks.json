{
  "description": "Stops the agent from reading the keyring or the approvals file directly, notices credentials pasted into chat, and forgets a session's approvals when it ends.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 15 }
        ]
      }
    ]
  }
}
